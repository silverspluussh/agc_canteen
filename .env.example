# Copy to `.env` for local development (do not commit `.env` with real secrets).
# Note: `.env` is bundled as a Flutter asset in release APKs — values are extractable.
# For production builds, prefer injecting secrets via --dart-define at build time.

# REST API base URL (required)
BASE_URL=https://api.example.com/

# Admin access code for settings from the staff auth screen (required)
ADMIN_ACCESS_CODE=your-secret-code-here
